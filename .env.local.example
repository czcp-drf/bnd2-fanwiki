NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BBS_MEDIA_MODE=storage
# GTA 지도 타일 CDN 베이스 URL (로컬 개발 시 비워두면 public/mapStyles/ 직접 서빙)
# 프로덕션: Cloudflare R2 등 CDN에 타일 업로드 후 URL 설정
# NEXT_PUBLIC_MAP_TILE_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# Bongstagram 서버 마지막 종료일 (KST, 해당일 오전 3시에 스토리 전체 종료)
# BONGSTAGRAM_SERVER_FINAL_DATE=2026-12-31

# Bongstagram 좋아요 저장 모드: server(기본값) 또는 local(브라우저 localStorage만 사용)
# 비상 시 Vercel 환경변수를 local로 변경해 좋아요 DB 쓰기를 즉시 차단할 수 있습니다.
# BONGSTAGRAM_LIKES_MODE=server

# 관리자 제보 접수 시 알림을 받을 Discord 채널 Webhook URL
# DISCORD_REPORT_WEBHOOK_URL=https://discord.com/api/webhooks/...
# 카테고리별 Webhook은 전체 Webhook과 함께 해당 유형 제보를 추가 전송합니다.
# DISCORD_REPORT_WEBHOOK_NEW_CHARACTER=https://discord.com/api/webhooks/...
# DISCORD_REPORT_WEBHOOK_NEW_EVENT=https://discord.com/api/webhooks/...
# DISCORD_REPORT_WEBHOOK_CORRECTION=https://discord.com/api/webhooks/...
# DISCORD_REPORT_WEBHOOK_OTHER=https://discord.com/api/webhooks/...
